pipeline {
    agent any
    environment{
        git_user = "shahir-devops"
        git_repo = "microservice"
    }

    stages {
        stage('git') {
            steps {
                git credentialsId: 'git_cred',
                    url: 'https://github.com/shahir-devops/microservice.git'
            }
        }

        stage('Build') {
            steps {
                script {

                    sh '''
                    docker system prune -af
                    docker build --no-cache -f packages/frontend/Dockerfile -t shahir5890/frontend:${BUILD_NUMBER} .
                    '''
                }
            }
        }
        stage(' Push') {
            steps {
                script {
                    withCredentials([
                            usernamePassword(
                                credentialsId: 'DOCKER_REGISTRY',
                                usernameVariable: 'docker_login',
                                passwordVariable: 'docker_pass'
                            )
                        ]) {
                            sh "docker push shahir5890/frontend:${BUILD_NUMBER}"
                        }
                }
            }
        }
        stage("replace_tag") {
            steps {
                withCredentials([string(credentialsId: 'git_Pat', variable: 'git_Pat')]) {
                    dir("kubernetes") {
                        sh """
                            git config user.email "shahirsyeed@gmail.com"
                            git config user.name "shahir-syed"

                            sed -i 's#image:.*#image: shahir5890/frontend:${BUILD_NUMBER}#' frontend.yaml

                            git add .
                            git commit -m "updated code on jenkins frontend:${BUILD_NUMBER}"
                            git push https://${git_Pat}@github.com/${git_user}/${git_repo}.git HEAD:master
                        """
                    }
                }
            }
        }
    }
}