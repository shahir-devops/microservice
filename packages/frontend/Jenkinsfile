pipeline {
  agent any

  environment {
    // Set these in Jenkins (recommended) or replace with your values.
    REGISTRY = credentials('DOCKER_REGISTRY') // e.g. "docker.io/youruser" or "ghcr.io/owner"
    IMAGE_TAG = "${env.BUILD_NUMBER}-${env.GIT_COMMIT.take(7)}"
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Build Frontend Docker image') {
      steps {
        script {
          def image = "${env.REGISTRY}/frontend:${env.IMAGE_TAG}"
          sh "docker build -t ${image} -f packages/frontend/Dockerfile ."
          sh "docker push ${image}"
        }
      }
    }
  }
}

