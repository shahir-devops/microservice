pipeline {
    agent any

    stages {
        stage('git') {
            steps {
                git credentialsId: 'git_cred',
                    url: 'https://github.com/shahir-devops/microservice.git'
            }
        }

        stage('Build & Push') {
            steps {
                script {

                    def services = [
                        'auth',
                        'profile',
                        'cart',
                        'notifications',
                        'wishlist',
                        'orders',
                        'payments',
                        'helpcenter',
                        'address',
                        'reviews'
                    ]

                    dir('packages') {

                        withCredentials([
                            usernamePassword(
                                credentialsId: 'DOCKER_REGISTRY',
                                usernameVariable: 'docker_login',
                                passwordVariable: 'docker_pass'
                            )
                        ]) {

                            sh '''
                                echo "$docker_pass" | docker login -u "$docker_login" --password-stdin
                            '''

                            for (service in services) {

                                sh """
                                    docker build \
                                    -f services/${service}/Dockerfile \
                                    -t shahir5890/backend_${service}:${BUILD_NUMBER} \
                                    .

                                    docker push shahir5890/backend_${service}:${BUILD_NUMBER}
                                    
                                """
                            }
                        }
                    }
                }
            }
        }
        stage("ks"){
            steps{
                dir('kubernetes') {
    sh 'ls -ltr'
}
            }
        }
        stage("replace_tag") {
            steps {
                dir("kubernetes") {
                    sh """
                        sed -i 's#image:.*#image: shahir5890/backend_auth:${BUILD_NUMBER}#' service-auth.yaml
                        sed -i 's#image:.*#image: shahir5890/backend_profile:${BUILD_NUMBER}#' service-profile.yaml
                        sed -i 's#image:.*#image: shahir5890/backend_cart:${BUILD_NUMBER}#' service-cart.yaml
                        sed -i 's#image:.*#image: shahir5890/backend_notifications:${BUILD_NUMBER}#' service-notification.yaml
                        sed -i 's#image:.*#image: shahir5890/backend_wishlist:${BUILD_NUMBER}#' service-wishlist.yaml
                        sed -i 's#image:.*#image: shahir5890/backend_orders:${BUILD_NUMBER}#' service-orders.yml
                        sed -i 's#image:.*#image: shahir5890/backend_payments:${BUILD_NUMBER}#' service-payment.yml
                        sed -i 's#image:.*#image: shahir5890/backend_helpcenter:${BUILD_NUMBER}#' service-helpcenter.yml
                        sed -i 's#image:.*#image: shahir5890/backend_address:${BUILD_NUMBER}#' service-address.yml
                        sed -i 's#image:.*#image: shahir5890/backend_reviews:${BUILD_NUMBER}#' service-reviews.yaml
                    """
                }
            }
        }
    }
}